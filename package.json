{
  "name": "agentpass",
  "private": true,
  "version": "0.1.0",
  "description": "AgentPass — an AI agent that checks your DeFi risk, verified human, paid per use, no API keys.",
  "scripts": {
    "dev": "pnpm --filter dashboard dev",
    "build": "pnpm -r build",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "pnpm -r exec rm -rf node_modules dist .next .turbo"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.27.0"
}
