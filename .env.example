# =============================================
# AgentPass — Environment Variables
# Copy this to .env and fill in real values
# ALL services below are FREE TIER / TESTNET
# =============================================

# --- PRD 01: ENS Identity (Sepolia Testnet) ---
SEPOLIA_RPC_URL=https://sepolia.gateway.tenderly.co
PRIVATE_KEY=your_test_wallet_private_key_NEVER_a_real_wallet
PARENT_NAME=agentpass.eth

# --- PRD 02: The Graph (Free 100k queries/month) ---
GRAPH_API_KEY=your_subgraph_studio_api_key

# --- PRD 03: Hedera Payments (Testnet + Blocky402) ---
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=your_hedera_testnet_private_key
HEDERA_NETWORK=testnet
HEDERA_PAY_TO=0.0.xxxxx
BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com
ANALYZE_API_URL=http://localhost:4001/analyze
ANALYZE_PRICE_HBAR=0.05
AGENT_SESSION_BUDGET_HBAR=1
API_PORT=4001
HCS_TOPIC_ID=

# --- PRD 04: World ID (Sandbox / Developer Portal) ---
WORLD_APP_ID=app_xxxxxxxx
WORLD_RP_ID=rp_xxxxxxxx
WORLD_RP_SIGNING_KEY=your_rp_signing_key_hex
WORLD_ACTION=agentpass-human-gate
WORLD_ENV=sandbox
# Allow labeled local demo credential when portal keys are missing (hackathon UX)
WORLD_ALLOW_SANDBOX_DEMO=true
# Optional: agent EVM wallet for AgentBook lookup on World Chain
AGENT_WALLET_ADDRESS=0x
# Optional: custom World Chain RPC for AgentBook
# WORLD_CHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
# WORLD_SESSION_STORE=.data/world-sessions.json

# --- PRD 05: Bazantic (Free Account) ---
BAZANTIC_USERNAME=your_bazantic_username

# --- General ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
